# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173
# Set to 1 (or true) when running behind a reverse proxy (Render, Fly, Nginx…) so rate limiting sees real client IPs
TRUST_PROXY=false

# --- Static hosting (optional) ---
# When true (default in production), serve ../portfolio-frontend/dist with SPA fallback if it exists
SERVE_CLIENT=false
# CLIENT_DIST_PATH=../portfolio-frontend/dist

# --- Mail (leave SMTP_* empty to log messages to the console instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=hrishikk8547@gmail.com
CONTACT_FROM="Portfolio Contact <no-reply@example.com>"
